<% layout("/layouts/boilerplate.ejs") -%>

<div class="row mt-4 mb-5">
  <div class="col-12 col-lg-10 offset-lg-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-bold mb-1">Host Dashboard</h3>
        <p class="text-muted mb-0">Overview of all reservations received for your properties</p>
      </div>
      <div>
        <a href="/listings/new" class="btn btn-dark add-btn text-white btn-sm">
          <i class="fa-solid fa-plus me-1"></i> Add New Listing
        </a>
      </div>
    </div>

    <!-- Summary Metrics -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-4">
        <div class="card shadow-sm border-0 p-3" style="border-radius: 1rem; background-color: #ffffff; border-left: 5px solid #fe424d !important;">
          <span class="text-muted small fw-semibold">Total Bookings Received</span>
          <h3 class="fw-bold text-dark mt-2 mb-0"><%= totalBookings %></h3>
        </div>
      </div>
      <div class="col-12 col-md-4">
        <div class="card shadow-sm border-0 p-3" style="border-radius: 1rem; background-color: #ffffff; border-left: 5px solid #10b981 !important;">
          <span class="text-muted small fw-semibold">Active Confirmed Bookings</span>
          <h3 class="fw-bold text-success mt-2 mb-0"><%= activeBookings %></h3>
        </div>
      </div>
      <div class="col-12 col-md-4">
        <div class="card shadow-sm border-0 p-3" style="border-radius: 1rem; background-color: #ffffff; border-left: 5px solid #3b82f6 !important;">
          <span class="text-muted small fw-semibold">Total Booking Value</span>
          <h3 class="fw-bold text-primary mt-2 mb-0">&#8377;<%= totalEarnings.toLocaleString("en-IN") %></h3>
        </div>
      </div>
    </div>

    <!-- Bookings List Table -->
    <% if (!bookings || bookings.length === 0) { %>
      <div class="card text-center p-5 shadow-sm border-0" style="border-radius: 1rem; background-color: #fafafa; border: 1px dashed #cccccc !important;">
        <div class="my-3">
          <i class="fa-solid fa-house-chimney-user text-muted" style="font-size: 3.5rem;"></i>
        </div>
        <h5 class="fw-bold text-dark">No Bookings Received Yet</h5>
        <p class="text-muted mb-0">When travelers book your properties, their reservation and guest details will appear here.</p>
      </div>
    <% } else { %>
      <div class="card shadow-sm border-0 p-3" style="border-radius: 1rem; background-color: #ffffff; border: 1px solid #e5e7eb !important;">
        <h5 class="fw-bold mb-3 px-2">Recent Reservations</h5>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr class="small text-muted">
                <th>Property</th>
                <th>Guest Details</th>
                <th>Booking ID</th>
                <th>Dates & Duration</th>
                <th>Guests</th>
                <th>Payout</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% for (let booking of bookings) { %>
                <tr>
                  <td>
                    <% if (booking.listing) { %>
                      <div class="d-flex align-items-center">
                        <img src="<%= booking.listing.image && booking.listing.image.url ? booking.listing.image.url : booking.listing.image %>" 
                             alt="<%= booking.listing.title %>" 
                             class="rounded me-2" 
                             style="width: 50px; height: 40px; object-fit: cover;">
                        <div>
                          <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none fw-semibold text-dark small d-block">
                            <%= booking.listing.title %>
                          </a>
                          <span class="text-muted small" style="font-size: 0.75rem;"><%= booking.listing.location %></span>
                        </div>
                      </div>
                    <% } else { %>
                      <span class="text-muted small">Property Removed</span>
                    <% } %>
                  </td>
                  <td>
                    <div>
                      <strong class="d-block small"><%= booking.user ? booking.user.username : "Guest" %></strong>
                      <span class="text-muted small" style="font-size: 0.8rem;"><%= booking.user ? booking.user.email : "N/A" %></span>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-dark small"><%= booking.bookingId %></span>
                  </td>
                  <td>
                    <span class="small d-block fw-semibold">
                      <%= new Date(booking.checkIn).toLocaleDateString("en-IN", { month: "short", day: "numeric" }) %>
                      &nbsp;&mdash;&nbsp;
                      <%= new Date(booking.checkOut).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) %>
                    </span>
                    <span class="text-muted small" style="font-size: 0.75rem;"><%= booking.nights %> night<%= booking.nights > 1 ? "s" : "" %></span>
                  </td>
                  <td>
                    <span class="small"><%= booking.guests %></span>
                  </td>
                  <td>
                    <strong class="small text-dark">&#8377;<%= booking.totalPrice.toLocaleString("en-IN") %></strong>
                  </td>
                  <td>
                    <% if (booking.status === "Confirmed") { %>
                      <span class="badge bg-success">Confirmed</span>
                    <% } else { %>
                      <span class="badge bg-danger">Cancelled</span>
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</div>

