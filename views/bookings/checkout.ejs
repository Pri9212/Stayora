<% layout("/layouts/boilerplate.ejs") -%>

<div class="row mt-4 mb-5">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <div class="d-flex align-items-center mb-3">
      <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary btn-sm me-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back
      </a>
      <h3 class="mb-0 fw-bold">Review Booking Details</h3>
    </div>
    <p class="text-muted">Review your reservation details and click Confirm Booking to finalize your stay.</p>

    <div class="row g-4 mt-1">
      <!-- Left Column: Property & Trip Summary -->
      <div class="col-md-7">
        <!-- Property Info Card -->
        <div class="card shadow-sm border-0 mb-4 p-3" style="border-radius: 1rem; background-color: #ffffff; border: 1px solid #e5e7eb !important;">
          <div class="d-flex align-items-center mb-3">
            <img src="<%= listing.image && listing.image.url ? listing.image.url : listing.image %>" 
                 alt="<%= listing.title %>" 
                 class="rounded" 
                 style="width: 90px; height: 80px; object-fit: cover;">
            <div class="ms-3">
              <h5 class="fw-bold mb-1"><%= listing.title %></h5>
              <p class="text-muted small mb-1">
                <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
              </p>
              <span class="small text-secondary">Host: <strong><%= listing.owner ? listing.owner.username : "Host" %></strong></span>
            </div>
          </div>
        </div>

        <!-- Trip Details Card -->
        <div class="card shadow-sm border-0 mb-4 p-3" style="border-radius: 1rem; background-color: #ffffff; border: 1px solid #e5e7eb !important;">
          <h5 class="fw-bold mb-3">Trip Information</h5>
          <div class="d-flex justify-content-between py-2 border-bottom">
            <div>
              <span class="fw-semibold d-block">Dates</span>
              <span class="text-muted small">
                <%= new Date(checkIn).toLocaleDateString("en-IN", { weekday: "short", month: "short", day: "numeric", year: "numeric" }) %>
                &nbsp;&mdash;&nbsp;
                <%= new Date(checkOut).toLocaleDateString("en-IN", { weekday: "short", month: "short", day: "numeric", year: "numeric" }) %>
              </span>
            </div>
            <div class="text-end">
              <span class="badge bg-light text-dark border"><%= nights %> night<%= nights > 1 ? "s" : "" %></span>
            </div>
          </div>
          <div class="d-flex justify-content-between py-2 border-bottom">
            <div>
              <span class="fw-semibold d-block">Guests</span>
              <span class="text-muted small"><%= guests %> guest<%= guests > 1 ? "s" : "" %></span>
            </div>
          </div>
          <div class="d-flex justify-content-between py-2">
            <div>
              <span class="fw-semibold d-block">Cancellation Policy</span>
              <span class="text-muted small">Free cancellation anytime before check-in</span>
            </div>
          </div>
        </div>

        <!-- Confirm Form (Direct Booking without payment) -->
        <form action="/listings/<%= listing._id %>/book" method="POST" id="confirmBookingForm">
          <input type="hidden" name="checkIn" value="<%= checkIn %>">
          <input type="hidden" name="checkOut" value="<%= checkOut %>">
          <input type="hidden" name="guests" value="<%= guests %>">

          <button type="submit" class="btn btn-dark w-100 py-3 add-btn text-white fw-bold fs-6 shadow-sm">
            <i class="fa-regular fa-circle-check me-2"></i>Confirm Booking
          </button>
          <p class="text-muted text-center small mt-2 mb-0">
            Instant booking confirmation &bull; Confirmation email will be delivered to your registered email
          </p>
        </form>
      </div>

      <!-- Right Column: Final Total Amount Breakdown -->
      <div class="col-md-5">
        <div class="card shadow-sm border-0 p-3 sticky-top" style="top: 6rem; border-radius: 1rem; background-color: #ffffff; border: 1px solid #e5e7eb !important;">
          <h5 class="fw-bold mb-3">Booking Summary</h5>

          <div class="d-flex justify-content-between py-1 small">
            <span>Price per night</span>
            <span>&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
          </div>

          <div class="d-flex justify-content-between py-1 small">
            <span>&#8377;<%= listing.price.toLocaleString("en-IN") %> × <%= nights %> night<%= nights > 1 ? "s" : "" %></span>
            <span>&#8377;<%= basePrice.toLocaleString("en-IN") %></span>
          </div>

          <div class="d-flex justify-content-between py-1 small">
            <span>Cleaning fee</span>
            <span>&#8377;<%= cleaningFee.toLocaleString("en-IN") %></span>
          </div>

          <hr class="my-3">

          <div class="d-flex justify-content-between py-1 fw-bold fs-5">
            <span>Total Amount</span>
            <span class="text-danger">&#8377;<%= totalPrice.toLocaleString("en-IN") %></span>
          </div>

          <p class="text-muted small mt-1 mb-3">
            Total amount for your <%= nights %>-night stay.
          </p>

          <div class="bg-light p-2 rounded small text-muted border">
            <i class="fa-solid fa-shield-halved text-success me-1"></i> Your booking is protected under Wanderlust Host Guarantee.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
